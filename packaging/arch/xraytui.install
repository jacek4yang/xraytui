post_install() {
  cat <<'MESSAGE'
xraytui is installed. Next steps:

  1. Create the starter policy and state database:
       xraytui init

  2. Start the per-user daemon:
       systemctl --user enable --now xraytuid.service

  3. Only if you want the system TUN, enable the privileged helper and add
     yourself to the group that may talk to it:
       sudo systemctl enable --now xraytui-netd.service
       sudo usermod -aG xraytui "$USER"
     Log out and back in for the group change to take effect.

  4. Check the environment:
       xraytui doctor

Nothing proxies anything until you add a node and point a profile at it.
Read /usr/share/doc/xraytui/STATUS.md for what is implemented and what is not.
MESSAGE
}

post_upgrade() {
  cat <<'MESSAGE'
Restart the daemon to pick up the new build:
    systemctl --user restart xraytuid.service
    sudo systemctl restart xraytui-netd.service   # only if you use the TUN

Configuration is migrated automatically, with a timestamped backup beside it.
Run `xraytui doctor` afterwards.
MESSAGE
}

pre_remove() {
  # Leave user configuration alone; only stop what we started and remove the
  # networking state the helper owns.
  systemctl --system stop xraytui-netd.service 2>/dev/null || true
  /usr/bin/xraytui-netd --recover --once 2>/dev/null || true
}

post_remove() {
  cat <<'MESSAGE'
Configuration in ~/.config/xraytui has been left in place. Remove it by hand if
you want it gone:
    rm -rf ~/.config/xraytui ~/.local/state/xraytui ~/.cache/xraytui
MESSAGE
}
