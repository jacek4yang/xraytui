# Maintainer: xraytui contributors
pkgname=xraytui
pkgver=1.0.0rc1
pkgrel=1
pkgdesc="Terminal client for Xray-core with multiple concurrent egress profiles"
arch=('x86_64' 'aarch64')
url="https://github.com/xraytui/xraytui"
license=('GPL-3.0-or-later')
# Xray-core is a hard runtime dependency: xraytui supervises it, it does not
# embed or reimplement it.
depends=('xray' 'nftables' 'iproute2')
makedepends=('cargo' 'protobuf' 'git')
optdepends=(
  'xray-geoip: geoip: routing rules'
  'xray-geosite: geosite: routing rules'
  'dmenu: profile and target pickers for dwm'
  'systemd-resolvconf: DNS management through resolvconf'
)
backup=(
  'etc/xraytui/netd.toml'
)
install=xraytui.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  # Vendor and lock so the build is reproducible and offline.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # The privileged and network-namespace tests are excluded: a package build
  # must not require CAP_NET_ADMIN, and must not touch host networking.
  cargo test --frozen --release --workspace --lib
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm0755 target/release/xraytui      "$pkgdir/usr/bin/xraytui"
  install -Dm0755 target/release/xraytuid     "$pkgdir/usr/bin/xraytuid"
  install -Dm0755 target/release/xraytui-netd "$pkgdir/usr/bin/xraytui-netd"

  # systemd units. The user service is unprivileged; only the helper is not.
  install -Dm0644 packaging/systemd/xraytuid.service \
    "$pkgdir/usr/lib/systemd/user/xraytuid.service"
  install -Dm0644 packaging/systemd/xraytui-netd.service \
    "$pkgdir/usr/lib/systemd/system/xraytui-netd.service"
  install -Dm0644 packaging/systemd/xraytui-tmpfiles.conf \
    "$pkgdir/usr/lib/tmpfiles.d/xraytui.conf"
  install -Dm0644 packaging/systemd/xraytui-sysusers.conf \
    "$pkgdir/usr/lib/sysusers.d/xraytui.conf"

  # Shell completions and man pages, generated by the binary itself so they
  # cannot drift from the command surface.
  install -dm0755 "$pkgdir/usr/share/bash-completion/completions"
  install -dm0755 "$pkgdir/usr/share/zsh/site-functions"
  install -dm0755 "$pkgdir/usr/share/fish/vendor_completions.d"
  ./target/release/xraytui completion bash > "$pkgdir/usr/share/bash-completion/completions/xraytui"
  ./target/release/xraytui completion zsh  > "$pkgdir/usr/share/zsh/site-functions/_xraytui"
  ./target/release/xraytui completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/xraytui.fish"

  install -dm0755 "$pkgdir/usr/share/man/man1"
  ./target/release/xraytui manpages "$pkgdir/usr/share/man/man1"

  # Documentation.
  install -Dm0644 README.md      "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 STATUS.md      "$pkgdir/usr/share/doc/$pkgname/STATUS.md"
  install -Dm0644 DECISIONS.md   "$pkgdir/usr/share/doc/$pkgname/DECISIONS.md"
  for doc in docs/*.md; do
    install -Dm0644 "$doc" "$pkgdir/usr/share/doc/$pkgname/$doc"
  done

  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
