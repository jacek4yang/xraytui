# Maintainer: xraytui contributors
pkgname=xraytui
pkgver=1.0.0
pkgrel=1
pkgdesc="Terminal client for Xray-core with multiple concurrent egress profiles"
arch=('x86_64')
url="https://github.com/jacek4yang/xraytui"
license=('GPL-3.0-or-later')
# ring and other Rust dependencies compile native C/assembly archives. Arch's
# global GCC LTO objects cannot be consumed by the Rust/lld link step, so this
# package keeps Cargo's release optimizations but disables makepkg's global LTO.
options=('!debug' '!lto')
# Xray-core is a hard runtime dependency: xraytui supervises it, it does not
# embed or reimplement it. The xray-bin and xray-git AUR packages both provide
# `xray`, so users may choose either implementation.
depends=(
  'glibc'
  'libgcc'
  'iproute2'
  'nftables'
  'sqlite'
  'systemd'
  'xray'
)
makedepends=(
  'pkgconf'
  'protobuf'
  'rust'
)
optdepends=(
  'dmenu: profile and target pickers for dwm'
  'systemd-resolvconf: DNS management through resolvconf'
  'openresolv: alternative DNS management through resolvconf'
)
install=xraytui.install
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SOURCE_ARCHIVE_SHA256')

prepare() {
  cd "$pkgname-$pkgver"
  # Fetch exactly Cargo.lock's dependency graph up front. `--frozen` below can
  # then enforce both the lock file and offline operation during build/check.
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Arch enables C LTO globally. The workspace's portable builds bundle
  # SQLite, but that GCC LTO archive cannot be consumed by Arch's lld flags.
  # Packages should use Arch's maintained shared SQLite in any case.
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  cargo build --frozen --release --workspace
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
  # Privileged/live-host tests are opt-in and therefore skip here; all ordinary
  # unit and integration tests run without touching the host network.
  cargo test --frozen --release --workspace
}

package() {
  cd "$pkgname-$pkgver"
  # The typed installer is also used by release-smoke.sh. Keeping one manifest
  # prevents the package, source installer, completions and man pages drifting.
  ./target/release/xtask install --prefix /usr --destdir "$pkgdir"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
